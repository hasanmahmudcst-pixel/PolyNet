# ==============================================================================
# PolyNet Production Environment Variables
# Use placeholders only in this file. NEVER commit actual production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & HOSTING
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# Base URL of the deployed application (Production or Development)
# Production: https://mypolynet.com
APP_URL="https://mypolynet.com"

# ------------------------------------------------------------------------------
# 2. GEMINI AI (Server-Side Only)
# ------------------------------------------------------------------------------
# Required for /api/polyai (PolyAI Academic Assistant) and /api/ai-reply
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE 5TB REELS STORAGE & OAUTH (Server-Side Only)
# ------------------------------------------------------------------------------
# Production OAuth Callback Route: /auth/google/callback
# Full Production Authorized Redirect URI: https://mypolynet.com/auth/google/callback
GOOGLE_REDIRECT_URI="https://mypolynet.com/auth/google/callback"

# Optional environment variable alternatives to google-oauth-client.json and google-drive-token.json files:
# Paste minified JSON strings if using containerized deployment (e.g. Cloud Run, VPS):
GOOGLE_OAUTH_CLIENT_JSON=""
GOOGLE_DRIVE_TOKEN_JSON=""

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK & PUSH NOTIFICATIONS (FCM) (Server-Side Only)
# ------------------------------------------------------------------------------
# Optional JSON string alternative to firebase-service-account.json:
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ------------------------------------------------------------------------------
# 5. MATRIX DECENTRALIZED REAL CHAT PROXY (Server-Side Only)
# ------------------------------------------------------------------------------
MATRIX_HOMESERVER="https://matrix-client.matrix.org"
MATRIX_ACCESS_TOKEN=""
MATRIX_USER_ID=""

# ------------------------------------------------------------------------------
# 6. CLIENT-SIDE FIREBASE (Public Config - Safe for Frontend)
# Configured in firebase-applet-config.json or Vite environment
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ------------------------------------------------------------------------------
# 8. EKLAS PAYMENT SYSTEM / EPS BD GATEWAY (Server-Side Only)
# ------------------------------------------------------------------------------
# Provider Mode: "sandbox" for testing, "live" for production
EKLAS_PAYMENT_MODE="sandbox"
# Provider Gateway Base URL (Defaults to https://system.eklas.dev)
EKLAS_PAYMENT_BASE_URL="https://system.eklas.dev"
# Server-to-Server Private API Secret Key (Do NOT use public pk_ keys here)
EKLAS_PAYMENT_API_KEY=""
# Merchant Account Client ID
EKLAS_PAYMENT_CLIENT_ID=""
# Webhook Signature Verification Secret (HMAC-SHA256)
EKLAS_PAYMENT_WEBHOOK_SECRET=""

